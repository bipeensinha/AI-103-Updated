# Copy to mcp_sql/.env and fill in your actual SQL Server values.
SQL_AUTH_MODE=sql
SQL_SERVER=192.168.1.100
SQL_PORT=1433
SQL_DATABASE=SalesDB
SQL_USERNAME=ai_readonly
SQL_PASSWORD=CHANGE_ME
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
SQL_CONNECTION_TIMEOUT=8
SQL_QUERY_TIMEOUT=15
